generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Uygulama calisma zamani: Supabase transaction pooler (port 6543).
  url       = env("DATABASE_URL")
  // Migration ve introspection: pooler DDL/advisory lock desteklemedigi icin
  // dogrudan baglanti gerekir (session pooler, port 5432).
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

// Ogretmenin davranis sistemi. Varsayilan basit arti/eksi; kart sistemi
// (uyari, sari/kirmizi kart, ceza) secime baglidir.
enum BehaviorTemplate {
  SIMPLE
  CARD
}

enum BehaviorType {
  PLUS
  MINUS
  YELLOW_CARD
  RED_CARD
}

enum SubmissionStatus {
  PENDING
  DONE
  MISSING
  LATE
}

enum MessageStatus {
  DRAFT
  SENT
}

/// Sinavin ne ise yaradigi. Resmi sinavlar karneye gider ve donem ortalamasi
/// onlardan hesaplanir; deneme/tarama ayni ortalamaya karismaz. Ayrim ortalama
/// ekranlarinin hangi kayitlara bakacagini belirler.
enum ExamScope {
  OFFICIAL
  PRACTICE
}

/// Bir sinav bileseninin puani nasil giriliyor. SCORE: ogretmen dogrudan puan
/// yazar. NET: dogru/yanlis sayisi girilir, net ve puan hesaplanir.
enum ComponentEntry {
  SCORE
  NET
}

// ---------- Core ----------

model Teacher {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  // Hangi davranis sisteminin kullanildigini belirler. Kayit katmani her iki
  // sablonda ayni; degisen hangi dugmelerin gosterildigi ve puanin nasil
  // isledigi. Ayarlardan degistirilir.
  behaviorTemplate BehaviorTemplate @default(SIMPLE)

  /// Akilli tahta kilidini acan PIN'in bcrypt hash'i. Hesap parolasindan
  /// AYRIDIR ve bilerek oyle: tahtaya yazilan sey sinifin tamami tarafindan
  /// gorulur, orada hesap parolasi yazilmamalidir. Ele gecerse yalnizca bu
  /// deger degistirilir, hesap etkilenmez. Null ise kilit henuz kurulmamistir
  /// ve cihaz kilitlenemez.
  boardPin String?

  /// PIN girildikten sonra cihazin kac dakika acik kalacagi. Sure dolunca
  /// cihaz kendiliginden kilitlenir.
  boardUnlockMinutes Int @default(10)

  classrooms     Classroom[]
  behaviorLogs   BehaviorLog[]
  assignments    Assignment[]
  exams          Exam[]
  parentMessages ParentMessage[]
}

model Classroom {
  id        String   @id @default(cuid())
  teacherId String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  teacher      Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  students     Student[]
  lessons      Lesson[]
  behaviorLogs BehaviorLog[]

  @@index([teacherId])
}

model Student {
  id          String  @id @default(cuid())
  classroomId String?
  firstName   String
  lastName    String
  parentName  String?
  parentPhone String?

  // Cached value. Kaynak gerçek BehaviorLog kayıtlarıdır; loglardan yeniden hesaplanabilir.
  performanceScore Int @default(90)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  classroom      Classroom?      @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  behaviorLogs   BehaviorLog[]
  breakPenalties BreakPenalty[]
  submissions    Submission[]
  examResults    ExamResult[]
  parentMessages ParentMessage[]

  @@index([classroomId])
}

// ---------- Ders ----------

/// Teneffuse gec cikma cezasi. Bir ogrencinin ayni anda en fazla bir acik
/// cezasi olur; yeni kirmizi kart geldiginde suresi mevcut cezaya eklenir.
/// Boylece ogretmen ogrenciyi bir kez tutar.
model BreakPenalty {
  id String @id @default(cuid())

  studentId String

  /// Toplam ceza suresi, saniye. Kirmizi kart geldikce artar; ogretmen
  /// kronometre uzerinden elle ekleyip cikarabilir.
  seconds Int

  /// Kronometrenin baslatildigi an. Null ise ceza henuz baslatilmamistir.
  startedAt DateTime?

  /// Ceza tamamlandiginda dolar. Null olan kayitlar "bekliyor" sayilir.
  completedAt DateTime?

  createdAt DateTime @default(now())

  // Restrict: ceza gecmisi olan ogrenci silinemez.
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId, completedAt])
}

model Lesson {
  id          String   @id @default(cuid())
  classroomId String
  date        DateTime

  /// Dersin bittigi an. Null ise ders suruyor: aktif ders budur. Bir sinifin
  /// ayni anda en fazla bir suren dersi olur, bu kural uygulamada korunur.
  /// Bitmis derse yeni davranis kaydi yazilamaz.
  endedAt DateTime?

  createdAt DateTime @default(now())

  classroom    Classroom     @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  behaviorLogs BehaviorLog[]

  // Bilerek unique kisit YOK: ayni sinifa ayni gun birden fazla ders islenebilir.
  // Yanlislikla acilan cift kayit uygulama tarafinda engellenir; kart kurallari
  // lessonId uzerinden calistigi icin ayni gundeki dersler birbirine karismaz.
  @@index([classroomId, date])
}

// ---------- Davranış ----------

// Append-only event log. Kayıtlar silinmez.
model BehaviorLog {
  id          String       @id @default(cuid())
  studentId   String
  teacherId   String
  classroomId String
  lessonId    String
  type        BehaviorType
  points      Int
  reason      String?
  createdAt   DateTime     @default(now())

  // Restrict: davranis gecmisi olan bir kayit silinemez.
  // Silme yerine arsivleme (Student.isActive) kullanilir.
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  lesson    Lesson    @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@index([studentId, createdAt])
  @@index([lessonId, studentId])
  @@index([classroomId, createdAt])
  @@index([teacherId])
}

// ---------- Ödev ----------

/// Odev bir sinifa degil ogretmene aittir: ayni odev birden fazla sinifa ve
/// tek tek secilen ogrencilere verilebilir. Kime verildigi Submission
/// satirlarinda yazilidir; sinif uyeligi oradan turetilir, ayrica tutulmaz.
model Assignment {
  id          String  @id @default(cuid())
  teacherId   String
  title       String
  description String?

  /// Odevin verildigi tarih. Gecmise donuk odev girilebilir, bu yuzden
  /// ileri/geri sinir yoktur. Bos birakilabilir.
  startDate DateTime?

  /// Son teslim tarihi. Gectiginde durum KENDILIGINDEN degismez; yalnizca
  /// ekranda "suresi gecti" olarak isaretlenir. Durumu ogretmen girer.
  dueDate DateTime?

  /// Arsivlenen odev listelerde gorunmez, kayitlari durur. Hicbir ogrenci
  /// isaretlenmemis odevler bunun yerine gercekten silinebilir.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restrict: teslim gecmisi olan odev, ogretmen silinerek yok edilemez.
  teacher     Teacher      @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  submissions Submission[]

  @@index([teacherId, createdAt])
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  status       SubmissionStatus @default(PENDING)
  note         String?
  updatedAt    DateTime         @updatedAt

  // Restrict: teslim kaydi gecmistir; odev veya ogrenci silinerek yok edilemez.
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

// ---------- Sınav ----------

/// Sinav bir sinifa degil ogretmene aittir: ayni sinav birden fazla sinifa ve
/// tek tek secilen ogrencilere verilebilir. Kime verildigi ExamResult
/// satirlarinda yazilidir; sinif uyeligi oradan turetilir, ayrica tutulmaz.
/// Odevdeki (Assignment) kararin aynisi; boylece ayni sinavin subeler arasi
/// ortalamasi karsilastirilabilir.
model Exam {
  id        String   @id @default(cuid())
  teacherId String
  title     String
  examDate  DateTime

  /// Sinavin tam puani. Her sinav 100 uzerinden degildir (Oxford sinavlari
  /// cogunlukla degil), bu yuzden sinav basina tutulur. Karsilastirma ve
  /// gelisim gorunumu ham puani degil bunun uzerinden yuzdeyi kullanir.
  maxScore Float @default(100)

  /// Karneye giren resmi sinav mi, deneme/tarama mi. Ortalamalar bu ayrimi
  /// kullanir: tarama sinavi karne ortalamasina karismaz.
  scope ExamScope @default(PRACTICE)

  createdAt DateTime @default(now())

  // Restrict: sonuc gecmisi olan sinav, ogretmen silinerek yok edilemez.
  teacher    Teacher         @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  components ExamComponent[]
  results    ExamResult[]

  @@index([teacherId, examDate])
}

/// Sinavin parcasi ve o parcanin agirligi. MEB sinavi uc bilesendir
/// (Yazili %50, Listening %25, Speaking %25); tek puanli bir sinav tek
/// bilesendir. Boylece dort ayri sinav modeli yazmak yerine tek mekanizma
/// hepsini karsilar, ve "sinifin Listening ortalamasi" sorulabilir hale gelir.
///
/// Bilesenler sinavin TANIMIDIR, gecmis degil: sinav silinirse birlikte gider.
model ExamComponent {
  id     String @id @default(cuid())
  examId String

  /// "Yazili", "Listening", "Speaking", "Reading"...
  name String

  /// Bilesenin sinav notuna agirligi, yuzde. Bir sinavin bilesen agirliklari
  /// toplam 100 etmelidir; kural exam-rules.ts icinde dogrulanir.
  weight Float

  /// Bilesenin kendi tam puani. Bilesenler farkli tam puanlarda olabilir,
  /// bu yuzden agirlikli hesap ham puani degil yuzdeyi kullanir.
  maxScore Float @default(100)

  /// Puan dogrudan mi girilir, dogru/yanlistan mi hesaplanir.
  entry ComponentEntry @default(SCORE)

  /// NET modunda soru sayisi. Net -> puan cevriminde paydadir.
  questionCount Int?

  /// NET modunda kac yanlisin bir dogruyu goturdugu. 3 = "3 yanlis 1 dogru
  /// goturur". Null ise yanlis puani etkilemez, yalnizca kayit icin tutulur.
  wrongDivisor Int?

  /// Ekranda ve not girme tablosunda sutun sirasi.
  order Int @default(0)

  // Cascade: bilesen sinavin tanimina aittir, ayri bir gecmis degil.
  exam    Exam                  @relation(fields: [examId], references: [id], onDelete: Cascade)
  entries ExamResultComponent[]

  @@index([examId, order])
}

model ExamResult {
  id        String @id @default(cuid())
  examId    String
  studentId String

  /// Sinavin bu ogrenci icin agirlikli sonucu, sinavin kendi tam puani
  /// uzerinden. KAYNAK DEGIL, TURETILMIS DEGERDIR: gercek veri bilesen
  /// girdileridir (ExamResultComponent), bu alan hizli erisim icin tutulan
  /// cached value'dur -- Student.performanceScore ile ayni prensip.
  ///
  /// Null ise sinav bu ogrenciye verilmis ama notu HENUZ TAMAMLANMAMISTIR.
  /// Odevdeki PENDING satirinin karsiligi. Bir bilesen bile eksikse puan
  /// hesaplanmaz: yarim girilmis MEB sinavi yaniltici bir dusuk not
  /// gostermesin. Ortalamalar yalnizca hesaplanmis puanlardan olusur.
  score Float?

  /// Ogrenci sinava girmedi. Bos puandan farkidir: bos "henuz girilmedi",
  /// bu "girmeyecek" demektir. Ortalamaya katilmaz ama sayilabilir.
  isAbsent Boolean @default(false)

  note      String?
  createdAt DateTime @default(now())

  // Restrict: sinav sonucu gecmistir.
  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  entries ExamResultComponent[]

  @@unique([examId, studentId])
  @@index([studentId])
}

/// Bir ogrencinin bir sinav bilesenindeki ham girdisi. Sinav notunun kaynagi
/// budur; ExamResult.score bundan hesaplanir.
///
/// SCORE modunda `score`, NET modunda `correct`/`wrong`/`blank` dolar.
model ExamResultComponent {
  id          String @id @default(cuid())
  resultId    String
  componentId String

  /// SCORE modunda girilen ham puan, bilesenin kendi tam puani uzerinden.
  score Float?

  /// NET modunda dogru/yanlis/bos sayilari. Net bunlardan hesaplanir,
  /// ayrica saklanmaz: sonradan yanlis oraninin degismesi gecmis kayitlari
  /// bozmasin diye turetilmis deger tutulmaz.
  correct Int?
  wrong   Int?
  blank   Int?

  // Cascade: girdi sonucun ve bilesenin parcasidir, ayri bir gecmis degil.
  // Bilesen sinavdan cikarilirsa girdileri de gider; ekran once uyarir.
  result    ExamResult    @relation(fields: [resultId], references: [id], onDelete: Cascade)
  component ExamComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([resultId, componentId])
  @@index([componentId])
}

// ---------- Veli ----------

model ParentMessage {
  id        String        @id @default(cuid())
  studentId String
  teacherId String
  body      String
  status    MessageStatus @default(DRAFT)
  sentAt    DateTime?
  createdAt DateTime      @default(now())

  // Restrict: veli iletisim gecmisi silinmez.
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@index([studentId, createdAt])
  @@index([teacherId])
}
