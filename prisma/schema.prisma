generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Uygulama calisma zamani: Supabase transaction pooler (port 6543).
  url       = env("DATABASE_URL")
  // Migration ve introspection: pooler DDL/advisory lock desteklemedigi icin
  // dogrudan baglanti gerekir (session pooler, port 5432).
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

// Ogretmenin davranis sistemi. Varsayilan basit arti/eksi; kart sistemi
// (uyari, sari/kirmizi kart, ceza) secime baglidir.
enum BehaviorTemplate {
  SIMPLE
  CARD
}

enum BehaviorType {
  PLUS
  MINUS
  YELLOW_CARD
  RED_CARD
}

enum SubmissionStatus {
  PENDING
  DONE
  MISSING
  LATE
}

enum MessageStatus {
  DRAFT
  SENT
}

// ---------- Core ----------

model Teacher {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  // Hangi davranis sisteminin kullanildigini belirler. Kayit katmani her iki
  // sablonda ayni; degisen hangi dugmelerin gosterildigi ve puanin nasil
  // isledigi. Ayarlardan degistirilir.
  behaviorTemplate BehaviorTemplate @default(SIMPLE)

  classrooms     Classroom[]
  behaviorLogs   BehaviorLog[]
  parentMessages ParentMessage[]
}

model Classroom {
  id        String   @id @default(cuid())
  teacherId String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  teacher      Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  students     Student[]
  lessons      Lesson[]
  assignments  Assignment[]
  exams        Exam[]
  behaviorLogs BehaviorLog[]

  @@index([teacherId])
}

model Student {
  id          String  @id @default(cuid())
  classroomId String?
  firstName   String
  lastName    String
  parentName  String?
  parentPhone String?

  // Cached value. Kaynak gerçek BehaviorLog kayıtlarıdır; loglardan yeniden hesaplanabilir.
  performanceScore Int @default(90)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  classroom      Classroom?      @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  behaviorLogs   BehaviorLog[]
  breakPenalties BreakPenalty[]
  submissions    Submission[]
  examResults    ExamResult[]
  parentMessages ParentMessage[]

  @@index([classroomId])
}

// ---------- Ders ----------

/// Teneffuse gec cikma cezasi. Bir ogrencinin ayni anda en fazla bir acik
/// cezasi olur; yeni kirmizi kart geldiginde suresi mevcut cezaya eklenir.
/// Boylece ogretmen ogrenciyi bir kez tutar.
model BreakPenalty {
  id String @id @default(cuid())

  studentId String

  /// Toplam ceza suresi, saniye. Kirmizi kart geldikce artar; ogretmen
  /// kronometre uzerinden elle ekleyip cikarabilir.
  seconds Int

  /// Kronometrenin baslatildigi an. Null ise ceza henuz baslatilmamistir.
  startedAt DateTime?

  /// Ceza tamamlandiginda dolar. Null olan kayitlar "bekliyor" sayilir.
  completedAt DateTime?

  createdAt DateTime @default(now())

  // Restrict: ceza gecmisi olan ogrenci silinemez.
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId, completedAt])
}

model Lesson {
  id          String   @id @default(cuid())
  classroomId String
  date        DateTime
  createdAt   DateTime @default(now())

  classroom    Classroom     @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  behaviorLogs BehaviorLog[]

  // Bilerek unique kisit YOK: ayni sinifa ayni gun birden fazla ders islenebilir.
  // Yanlislikla acilan cift kayit uygulama tarafinda engellenir; kart kurallari
  // lessonId uzerinden calistigi icin ayni gundeki dersler birbirine karismaz.
  @@index([classroomId, date])
}

// ---------- Davranış ----------

// Append-only event log. Kayıtlar silinmez.
model BehaviorLog {
  id          String       @id @default(cuid())
  studentId   String
  teacherId   String
  classroomId String
  lessonId    String
  type        BehaviorType
  points      Int
  reason      String?
  createdAt   DateTime     @default(now())

  // Restrict: davranis gecmisi olan bir kayit silinemez.
  // Silme yerine arsivleme (Student.isActive) kullanilir.
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  lesson    Lesson    @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@index([studentId, createdAt])
  @@index([lessonId, studentId])
  @@index([classroomId, createdAt])
  @@index([teacherId])
}

// ---------- Ödev ----------

model Assignment {
  id          String    @id @default(cuid())
  classroomId String
  title       String
  description String?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  classroom   Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([classroomId])
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  status       SubmissionStatus @default(PENDING)
  note         String?
  updatedAt    DateTime         @updatedAt

  // Restrict: teslim kaydi gecmistir; odev veya ogrenci silinerek yok edilemez.
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

// ---------- Sınav ----------

model Exam {
  id          String   @id @default(cuid())
  classroomId String
  title       String
  examDate    DateTime
  maxScore    Float    @default(100)
  createdAt   DateTime @default(now())

  classroom Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  results   ExamResult[]

  @@index([classroomId])
}

model ExamResult {
  id        String   @id @default(cuid())
  examId    String
  studentId String
  score     Float
  note      String?
  createdAt DateTime @default(now())

  // Restrict: sinav sonucu gecmistir.
  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([examId, studentId])
  @@index([studentId])
}

// ---------- Veli ----------

model ParentMessage {
  id        String        @id @default(cuid())
  studentId String
  teacherId String
  body      String
  status    MessageStatus @default(DRAFT)
  sentAt    DateTime?
  createdAt DateTime      @default(now())

  // Restrict: veli iletisim gecmisi silinmez.
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@index([studentId, createdAt])
  @@index([teacherId])
}
